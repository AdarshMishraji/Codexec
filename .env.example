# Common
DATABASE_URL=postgres://codexec:codexec@localhost:5432/codexec
NATS_URL=nats://127.0.0.1:4222
RUST_LOG=info

# codexec-api
API_BIND_ADDR=0.0.0.0:8080
ADMIN_API_TOKEN=change-me-dev-token
DB_POOL_SIZE=10
MAX_SOURCE_CODE_BYTES=65536
PLATFORM_MAX_CPU_TIME_LIMIT_MS=60000
PLATFORM_MAX_CPU_LIMIT_CORES=4.0
PLATFORM_MAX_MEMORY_LIMIT_KB=4194304
WALL_TIME_MULTIPLIER=3
WALL_TIME_FIXED_OVERHEAD_MS=2000
PLATFORM_MAX_WALL_TIME_MS=120000
RUN_MIGRATIONS_ON_STARTUP=true

# codexec-worker
# Note: the worker always uses the real containerd-backed execution engine
# (crates/codexec-exec-engine) - there is no mock/unsandboxed mode. See
# docker-compose.yml's `worker` service (dev/test only) for a containerd +
# runc + codexec-worker image you can run via colima/Docker Desktop when
# you don't have a bare-metal Linux host with containerd available.
CONTAINERD_SOCKET_PATH=/run/containerd/containerd.sock
CONTAINERD_NAMESPACE=codexec
CONTAINERD_SNAPSHOTTER=overlayfs
WORKSPACE_ROOT=/var/lib/codexec/workspaces
CGROUP_ROOT=/sys/fs/cgroup
WORKER_CONCURRENCY=4
ENGINE_TOTAL_CPU_CORES=1.0
ENGINE_TOTAL_MEMORY_MB=1024
WORKER_CONSUMER_NAME=workers-generic
WORKER_CONSUMER_FILTER_SUBJECT=codexec.submissions.>
NATS_ACK_WAIT_SECS=120
NATS_MAX_DELIVER=5
