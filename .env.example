# Container images — read by docker-compose.yml (for the `api` and
# `worker` services) and by docker/publish.sh. Only relevant when running
# the stack in Docker; native processes ignore these. Set the namespace to
# a Docker Hub account/org you own before publishing.
CODEXEC_IMAGE_NAMESPACE=codexec
CODEXEC_IMAGE_TAG=latest

# Common
DATABASE_URL=postgres://codexec:codexec@localhost:5432/codexec
NATS_URL=nats://127.0.0.1:4222
RUST_LOG=info

# codexec-api
API_BIND_ADDR=0.0.0.0:8080
ADMIN_API_TOKEN=change-me-dev-token
DB_POOL_SIZE=10
MAX_SOURCE_CODE_BYTES=65536
PLATFORM_MAX_CPU_TIME_LIMIT_MS=60000
PLATFORM_MAX_CPU_LIMIT_CORES=4.0
PLATFORM_MAX_MEMORY_LIMIT_KB=4194304
WALL_TIME_MULTIPLIER=3
WALL_TIME_FIXED_OVERHEAD_MS=2000
PLATFORM_MAX_WALL_TIME_MS=120000
RUN_MIGRATIONS_ON_STARTUP=true

# codexec-worker
# Note: the worker always uses the real runc-backed execution engine
# (crates/codexec-exec-engine) - there is no mock/unsandboxed mode, and no
# daemon (containerd/Docker) at submission time - runc runs as a plain
# subprocess per submission against an image already unpacked by
# `codexec-plugin-cli register` (via skopeo+umoci, see IMAGE_CACHE_ROOT).
# See docker-compose.yml's `worker` service (dev/test only) for a
# runc+skopeo+umoci+codexec-worker image you can run via colima/Docker
# Desktop when you don't have a bare-metal Linux host available.
IMAGE_CACHE_ROOT=/var/lib/codexec/images
RUNC_ROOT=/run/codexec/runc
WORKSPACE_ROOT=/var/lib/codexec/workspaces
CGROUP_ROOT=/sys/fs/cgroup
WORKER_CONCURRENCY=4
ENGINE_TOTAL_CPU_CORES=1.0
ENGINE_TOTAL_MEMORY_MB=1024
WORKER_CONSUMER_NAME=workers-generic
WORKER_CONSUMER_FILTER_SUBJECT=codexec.submissions.>
NATS_ACK_WAIT_SECS=120
NATS_MAX_DELIVER=5
